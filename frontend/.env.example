# API base URL
VITE_API_BASE_URL=https://taajanews-api.onrender.com/api

# Public website URL (canonical links, Open Graph, JSON-LD) — no trailing slash
VITE_SITE_URL=https://taajanews.net

# Google OAuth & Maps
# IMPORTANT: Use OAuth 2.0 Client ID type "Web application" (NOT Installed/Android).
# Google Cloud Console → Credentials → Create OAuth client ID → Web application
# Authorized JavaScript origins (required for web login):
#   http://localhost:5173
#   https://taajanews.net
#   https://www.taajanews.net
# Same Client ID in backend GOOGLE_CLIENT_ID and here:
# VITE_GOOGLE_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
# VITE_GOOGLE_MAPS_API_KEY=
