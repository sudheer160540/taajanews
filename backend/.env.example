# Database
MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/taajanews

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your_account;AccountKey=your_key;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=your_container
AZURE_STORAGE_URL=https://your_account.blob.core.windows.net

# JWT Configuration
JWT_SECRET=your_secure_random_jwt_secret_key
JWT_EXPIRES_IN=7d

# Server Configuration
PORT=5000
NODE_ENV=development

# CORS
FRONTEND_URL=http://localhost:5173

# ─────────────────────────────────────────────────────────────────────
# Firebase Cloud Messaging (push notifications)
# ─────────────────────────────────────────────────────────────────────
# SECURITY: NEVER commit a service-account JSON file. The Firebase config
# loader (backend/src/config/firebase.js) reads credentials in this order:
#
# 1) FIREBASE_SERVICE_ACCOUNT_JSON_BASE64
#    Base64 of the entire service-account JSON. Preferred for production.
#    Generate with:  base64 -i path/to/serviceAccount.json | tr -d '\n'
#
# 2) FIREBASE_SERVICE_ACCOUNT_JSON
#    Raw JSON string of the service account (single line, escaped quotes).
#
# 3) FIREBASE_SERVICE_ACCOUNT_PATH or GOOGLE_APPLICATION_CREDENTIALS
#    Absolute filesystem path to a service-account JSON file. The file
#    MUST live outside the repo OR match a .gitignore rule (we ignore
#    *-firebase-adminsdk-*.json by default).
#
# If none of these are set, push notifications become a no-op (logged
# warning) and the article API continues to work normally.
# FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=
# FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/outside/repo/serviceAccount.json

# ─────────────────────────────────────────────────────────────────────
# Source article cron (ingest → translate → draft Article)
# ─────────────────────────────────────────────────────────────────────
# OPEN_API_KEY is required for OpenAI translation (also used by /api/translate).
# TRANSLATE_TYPE=sarvam uses Sarvam instead when set.
OPEN_API_KEY=
AUTOMATION_AUTHOR_ID=
DEFAULT_FEATURED_IMAGE_URL=https://taajanews.blob.core.windows.net/images/default_breaking_news.png
SOURCE_CRON_BATCH_SIZE=5
# Comma-separated scraper sources that always send Telugu content (lowercase)
TELUGU_SOURCES=eenadu
# Optional: sources that always send English content (overrides script detection)
# ENGLISH_SOURCES=
SOURCE_SUMMARY_MIN_CHARS=300
SOURCE_SUMMARY_MAX_CHARS=500
SOURCE_CONTENT_MAX_WORDS=1000
# TRANSLATE_TYPE=openai
