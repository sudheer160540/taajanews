# Anthropic Claude — article paraphrase/translate (Telugu, Hindi, English)
ANTHROPIC_API_KEY=your_anthropic_api_key
# Optional: override model (default claude-sonnet-4-20250514)
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ─────────────────────────────────────────────────────────────────────
# 1) Enable 2-Step Verification on your Google account
# 2) Google Account → Security → App passwords → create "Mail" app password
# 3) Use that 16-character password as SMTP_PASS (not your Gmail login password)
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM="Taaja News <your@gmail.com>"
PASSWORD_RESET_EXPIRES_MINUTES=60

# Social auto-post on first publish (optional — skip platform if unset)
# Facebook Page only (not user profile). Never use publish_actions.
# App credentials — server only. Used by POST /api/facebook/connect
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v26.0
# Optional extra key for encrypting stored Page tokens (falls back to JWT_SECRET)
# FACEBOOK_TOKEN_ENCRYPT_KEY=
# Optional fallback if Mongo connection is empty
# Prefer exchanging a short Explorer token (admin):
#   POST /api/facebook/tokens/exchange  { "shortLivedUserToken": "EAA..." }
# Permissions: pages_show_list, pages_read_engagement, pages_manage_posts
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
# Shown on Facebook / X / Instagram posts instead of the website article URL
ANDROID_APP_URL=https://play.google.com/store/apps/details?id=com.taajanews.app&hl=en_IN
ANDROID_APP_LINK_NAME=Download TAAJA News
# Instagram professional account. Token: instagram_content_publish (FB Login)
# or instagram_business_content_publish (Instagram Login).
# ig-user-id from GET /{page-id}?fields=instagram_business_account
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
# X / Twitter — posting needs USER tokens, not the app Bearer Token.
# Portal names → env:
#   Consumer Key (API Key)     → X_API_KEY
#   Consumer Secret (Secret Key) → X_API_SECRET
#   Access Token               → X_ACCESS_TOKEN
#   Access Token Secret        → X_ACCESS_TOKEN_SECRET
# Bearer Token is app-only (read). Do NOT put it in X_ACCESS_TOKEN.
# Get user tokens: developer.x.com → App → User authentication (Read and write)
# → Keys and tokens → Access Token and Secret → Generate.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
