# Anthropic Claude — article paraphrase/translate (Telugu, Hindi, English)
ANTHROPIC_API_KEY=your_anthropic_api_key
# Optional: override model (default claude-sonnet-4-20250514)
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ─────────────────────────────────────────────────────────────────────
# 1) Enable 2-Step Verification on your Google account
# 2) Google Account → Security → App passwords → create "Mail" app password
# 3) Use that 16-character password as SMTP_PASS (not your Gmail login password)
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM="Taaja News <your@gmail.com>"
PASSWORD_RESET_EXPIRES_MINUTES=60
